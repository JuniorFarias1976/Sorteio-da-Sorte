{
  "entities": {
    "RaffleConfig": {
      "title": "RaffleConfig",
      "description": "Global configuration and brand settings for the SorteioLive platform",
      "type": "object",
      "properties": {
        "companyName": { "type": "string" },
        "companySlogan": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "backgroundTheme": { "type": "string" },
        "raffleUrl": { "type": "string" },
        "contactEmail": { "type": "string" },
        "termsAndConditions": { "type": "string" },
        "logoAnimationEffect": { "type": "string", "enum": ["pulse", "heartbeat", "glow", "bounce", "float", "none"] },
        "modalLogoSize": { "type": "string", "enum": ["normal", "large", "xlarge", "2xlarge"] },
        "showFormPrizeHighlight": { "type": "boolean" },
        "showConsentVisitSection": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyName", "primaryColor"]
    },
    "Participant": {
      "title": "Participant",
      "description": "Participant registered in the live raffle",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "document": { "type": "string" },
        "clinic": { "type": "string" },
        "city": { "type": "string" },
        "specialty": { "type": "string" },
        "wantsLacerVisit": { "type": "boolean" },
        "hcpDatabaseConsent": { "type": "boolean" },
        "marketingConsent": { "type": "boolean" },
        "profilingConsent": { "type": "boolean" },
        "termsAccepted": { "type": "boolean" },
        "ticketNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "winner", "banned"] }
      },
      "required": ["id", "name", "ticketNumber", "status"]
    },
    "Prize": {
      "title": "Prize",
      "description": "Prize available for live draw",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "totalQuantity": { "type": "number" },
        "drawnQuantity": { "type": "number" },
        "imageUrl": { "type": "string" },
        "estimatedValue": { "type": "number" },
        "drawOrder": { "type": "number" }
      },
      "required": ["id", "title", "totalQuantity", "drawnQuantity"]
    },
    "DrawSchedule": {
      "title": "DrawSchedule",
      "description": "Scheduled round for live raffle draws",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledTime": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "live", "completed", "cancelled"] },
        "roundNumber": { "type": "number" },
        "roundLabel": { "type": "string" },
        "isLocked": { "type": "boolean" },
        "manuallyUnlocked": { "type": "boolean" },
        "drawnAt": { "type": "string", "format": "date-time" },
        "unlockedAt": { "type": "string", "format": "date-time" },
        "unlockedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "scheduledDate", "scheduledTime", "status"]
    },
    "DrawWinner": {
      "title": "DrawWinner",
      "description": "Contemplated winner in a live draw round",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "drawId": { "type": "string" },
        "drawTitle": { "type": "string" },
        "participantId": { "type": "string" },
        "participantName": { "type": "string" },
        "participantEmail": { "type": "string" },
        "participantPhone": { "type": "string" },
        "participantTicket": { "type": "string" },
        "participantDocument": { "type": "string" },
        "prizeId": { "type": "string" },
        "prizeTitle": { "type": "string" },
        "wonAt": { "type": "string", "format": "date-time" },
        "validationHash": { "type": "string" }
      },
      "required": ["id", "participantId", "participantName", "participantTicket", "prizeId", "prizeTitle", "wonAt", "validationHash"]
    },
    "NotificationLog": {
      "title": "NotificationLog",
      "description": "Notification dispatch history log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "channel": { "type": "string" },
        "recipientCount": { "type": "number" },
        "sentAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["sent", "pending", "failed"] },
        "eventTitle": { "type": "string" }
      },
      "required": ["id", "channel", "sentAt", "status"]
    },
    "AppUser": {
      "title": "AppUser",
      "description": "User profile with role-based permissions (admin or standard)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "standard"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "username", "name", "role", "active"]
    }
  },
  "firestore": {
    "/system/brand": {
      "schema": { "$ref": "RaffleConfig" },
      "description": "Stores the central brand configuration and theme"
    },
    "/participants/{participantId}": {
      "schema": { "$ref": "Participant" },
      "description": "Stores registered raffle participants"
    },
    "/prizes/{prizeId}": {
      "schema": { "$ref": "Prize" },
      "description": "Stores available raffle prizes"
    },
    "/schedules/{scheduleId}": {
      "schema": { "$ref": "DrawSchedule" },
      "description": "Stores scheduled raffle draw rounds"
    },
    "/winners/{winnerId}": {
      "schema": { "$ref": "DrawWinner" },
      "description": "Stores confirmed raffle winners"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "NotificationLog" },
      "description": "Stores notification dispatch logs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "AppUser" },
      "description": "Stores system operators and administrators"
    }
  }
}
